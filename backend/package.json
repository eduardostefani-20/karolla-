{
  "name": "@karolla/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --target node20 --out-dir dist --clean --noExternal @karolla/shared",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "2.1"
  },
  "dependencies": {
    "@karolla/shared": "*",
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "zod": "3.23"
  }
}
