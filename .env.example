# =============================================================================
# KAROLLA PET — variáveis de ambiente
# Copie para `.env` (nunca faça commit do .env). Valores vazios = recurso desligado.
# Tudo aqui é lido SOMENTE pelo back-end. O front-end só conhece VITE_API_URL.
# =============================================================================

# demo = dados fictícios em memória | production = Supabase obrigatório
APP_MODE=demo
PORT=3333
CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
TIMEZONE=America/Sao_Paulo

# --- Supabase (banco + autenticação) -----------------------------------------
# DATABASE_PROVIDER / AUTH_PROVIDER: padrão "memory"/"mock" no demo e "supabase" em produção
DATABASE_PROVIDER=
AUTH_PROVIDER=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ Service role: SOMENTE no servidor. Nunca em variável VITE_ nem no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Login de demonstração (apenas APP_MODE=demo) ------------------------------
# Se a senha ficar vazia, uma senha temporária aleatória é exibida no console da API.
DEMO_ADMIN_EMAIL=admin@karollapet.demo
DEMO_ADMIN_PASSWORD=
# Assinatura dos tokens do login demo (gere com: openssl rand -hex 32)
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=12

# --- WhatsApp ---------------------------------------------------------------------
# Número inicial da Karolla Pet (com DDI 55). Depois é editável no painel → Configurações.
WHATSAPP_NUMBER=
# link = gera link wa.me com a mensagem (padrão) | cloud_api = envia pela Meta | disabled
WHATSAPP_PROVIDER=link
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0

# --- Google Sheets (Apps Script Web App) ------------------------------------------
GOOGLE_SHEETS_WEBHOOK=
GOOGLE_SHEETS_WEBHOOK_SECRET=

INTEGRATION_TIMEOUT_MS=8000

# --- Front-end (Vite) ---------------------------------------------------------------
# Vazio = mesma origem (/api). Em deploy separado: URL pública da API.
VITE_API_URL=
